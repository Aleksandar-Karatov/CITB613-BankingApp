@using BankingApp.Business.Models
@{
    var product = ViewBag.Product as BankProduct;
    var result = ViewBag.Result as DepositCalculationResult;
    var error = ViewBag.ErrorMessage as string;
    var amount = ViewBag.Amount as decimal?;

    ViewData["Title"] = "Изчисли: " + product?.Name;
}

<div class="container mt-5 pt-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Каталог</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@product?.Id" class="text-decoration-none">Детайли</a></li>
            <li class="breadcrumb-item active" aria-current="page">Изчисли</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Въведете сума</h5>
                </div>
                <div class="card-body p-4 bg-light">
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
                        </div>
                    }

                    <form method="post" asp-action="Calculate">
                        <input type="hidden" name="id" value="@product?.Id" />
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">Сума за изчисление (@product?.Currency)</label>
                            <div class="input-group input-group-lg">
                                <input type="number" step="0.01" name="amount" class="form-control" 
                                       value="@amount" required placeholder="Напр. 10000" />
                                <span class="input-group-text">@product?.Currency</span>
                            </div>
                            <div class="form-text mt-2">
                                <span class="@(product != null && product.MinAmount > 0 ? "text-muted" : "")">
                                    Мин: @product?.MinAmount.ToString("N0")
                                </span>
                                |
                                <span class="@(product != null && product.MaxAmount > 0 ? "text-muted" : "")">
                                    Макс: @product?.MaxAmount.ToString("N0")
                                </span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100 shadow-sm">
                            Изчисли
                        </button>
                    </form>
                </div>
            </div>

            <!-- Product Specs Summary -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-accent mb-3">Параметри на депозита</h6>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Банка</span>
                            <strong>@product?.BankName</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Лихва</span>
                            <strong class="text-success">@product?.InterestRate.ToString("0.00")%</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Срок</span>
                            <strong>@product?.TermMonths мес.</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Тип лихва</span>
                            <strong>@(product?.InterestType == "Simple" ? "Проста" : "Сложна")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Изплащане</span>
                            <strong>@(product?.PayoutFrequency == "AtMaturity" ? "На падеж" : "Месечно")</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            @if (result != null)
            {
                <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0">Резултат от изчислението</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="row g-0">
                            <div class="col-md-4 p-4 border-end bg-light text-center">
                                <div class="text-muted small fw-bold text-uppercase mb-2">Главница</div>
                                <div class="fs-4">@result.Principal.ToString("N2") @product?.Currency</div>
                            </div>
                            <div class="col-md-4 p-4 border-end bg-light text-center">
                                <div class="text-muted small fw-bold text-uppercase mb-2">Чиста печалба</div>
                                <div class="fs-4 text-success">+@result.NetInterest.ToString("N2") @product?.Currency</div>
                            </div>
                            <div class="col-md-4 p-4 bg-light text-center">
                                <div class="text-muted small fw-bold text-uppercase mb-2">Общо за получаване</div>
                                <div class="fs-3 fw-bold text-accent">@result.TotalNetPayout.ToString("N2") @product?.Currency</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white p-4">
                        <div class="row text-center">
                            <div class="col-4 border-end">
                                <div class="small text-muted">Брутна лихва</div>
                                <strong>@result.GrossInterest.ToString("N2") @product?.Currency</strong>
                            </div>
                            <div class="col-4 border-end">
                                <div class="small text-muted">Удържан данък (@product?.TaxRate.ToString("0.0")%)</div>
                                <strong class="text-danger">-@result.TaxAmount.ToString("N2") @product?.Currency</strong>
                            </div>
                            <div class="col-4">
                                <div class="small text-muted">Ефективна год. лихва (ЕГЛ)</div>
                                <strong class="text-success">@result.EffectiveAnnualRate.ToString("0.00")%</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="mb-3 mt-5"><i class="bi bi-calendar3 text-accent me-2"></i>Разплащателен план (Амортизационен план)</h4>
                <div class="card shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center">Месец</th>
                                    <th class="text-end">Начално салдо</th>
                                    <th class="text-end text-success">Начислена лихва</th>
                                    <th class="text-end text-danger">Данък</th>
                                    <th class="text-end text-success fw-bold">Нетна лихва</th>
                                    <th class="text-end fw-bold">Крайно салдо</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in result.Schedule)
                                {
                                    <tr>
                                        <td class="text-center"><strong>@line.Month</strong></td>
                                        <td class="text-end">@line.StartBalance.ToString("N2")</td>
                                        <td class="text-end text-success">@line.InterestEarned.ToString("N2")</td>
                                        <td class="text-end text-danger">@line.TaxDeducted.ToString("N2")</td>
                                        <td class="text-end text-success fw-bold">@line.NetInterest.ToString("N2")</td>
                                        <td class="text-end fw-bold bg-light">@line.EndBalance.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (string.IsNullOrEmpty(error))
            {
                <!-- Empty state before calculation -->
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center p-5 bg-light rounded text-muted" style="min-height: 400px; border: 2px dashed #dee2e6;">
                    <div class="fs-1 mb-3 text-accent"><i class="bi bi-calculator"></i></div>
                    <h5>Въведете сума и натиснете "Изчисли"</h5>
                    <p>Тук ще се появи вашият разплащателен план и анализ на доходността.</p>
                </div>
            }
        </div>
    </div>
</div>
