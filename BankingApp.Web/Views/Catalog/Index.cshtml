@model IEnumerable<BankingApp.Business.Models.BankProduct>

@{
    ViewData["Title"] = "Каталог на депозити";
}

<div class="container mt-5 pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-journal-text text-accent me-2"></i>Каталог на депозити</h2>
        <a asp-action="Search" class="btn btn-outline-primary"><i class="bi bi-search me-1"></i>Разширено търсене</a>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-primary">@product.Currency</span>
                            <span class="text-muted small">@product.BankName</span>
                        </div>
                        <h5 class="card-title text-accent">
                            <a asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none">
                                @product.Name
                            </a>
                        </h5>
                        <p class="card-text text-muted small mb-3 text-truncate" style="max-height: 40px;">
                            @product.Description
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mb-3">
                            <div class="text-center w-50 border-end">
                                <span class="d-block text-muted" style="font-size: 0.75rem;">Лихва</span>
                                <strong class="text-success fs-5">@product.InterestRate.ToString("0.00")%</strong>
                            </div>
                            <div class="text-center w-50">
                                <span class="d-block text-muted" style="font-size: 0.75rem;">Срок</span>
                                <strong>@product.TermMonths мес.</strong>
                            </div>
                        </div>

                        <ul class="list-unstyled small mb-0">
                            <li><span class="text-muted">Мин. сума:</span> <strong>@product.MinAmount.ToString("N0") @product.Currency</strong></li>
                            <li><span class="text-muted">Макс. сума:</span> <strong>@product.MaxAmount.ToString("N0") @product.Currency</strong></li>
                        </ul>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0 pb-3">
                        <a asp-action="Calculate" asp-route-id="@product.Id" class="btn btn-accent w-100">
                            <i class="bi bi-calculator me-1"></i>Изчисли
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
